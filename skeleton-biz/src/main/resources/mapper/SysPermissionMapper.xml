<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zly.skeleton.biz.mapper.SysPermissionMapper">

    <select id="selectPermissionsByRoleIds" resultType="com.zly.skeleton.mybatisplus.entity.SysPermission">
        select p.*
        from sys_permission as p
        left join sys_role_permission rp on p.is_deleted = 'N' and rp.is_deleted = 'N' and p.id = rp.permission_id
        where rp.role_id in
        <foreach collection="roleIdSet" item="item" open="(" separator=","  close=")">
            #{item}
        </foreach>
    </select>

</mapper>